---
layout: base.njk
title: Past Bulletins
---

<header class="page-header">
  <img class="bulletin-hero__landscape" src="/assets/mountain-hero.png" alt="" aria-hidden="true" />
  <h1>Past Bulletins</h1>
  <p>Weekly bulletins from Calvary Chapel Antelope Valley.</p>
</header>

<div class="previous-layout">
  {% if previousBulletins and previousBulletins.length %}
  <ul class="bulletin-list">
    {% for item in previousBulletins %}
    <li>
      <a href="/previous/{{ item.date }}/" class="bulletin-list-item">
        <div>
          <div class="bulletin-list-item__date">{{ item.date | readableDate }}</div>
          {% set heading = item | headline %}
          <div class="bulletin-list-item__theme">{{ heading.title or heading.reference or "Weekly Bulletin" }}</div>
          {% if heading.title and heading.reference %}<div class="bulletin-list-item__reference">{{ heading.reference | referenceHtml | safe }}</div>{% endif %}
        </div>
        <span class="bulletin-list-item__arrow">
          <i data-lucide="arrow-right"></i>
        </span>
      </a>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p style="text-align:center; color:var(--fg-3); padding: var(--space-9) 0;">
    No past bulletins yet.
  </p>
  {% endif %}
</div>
