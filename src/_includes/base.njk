{% if archivedBulletin %}{% set bulletin = archivedBulletin %}{% endif %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% if title %}{{ title }} — {% endif %}Calvary Chapel AV Weekly Bulletin</title>
  <meta name="description" content="Weekly bulletin for Calvary Chapel Antelope Valley — Lancaster, CA" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="icon" type="image/png" href="/assets/dove-ink.png" />
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/editorial.css" />
  <style>
    :root {
      --logo-h: {{ bulletin.appearance.logoDesktop or 38 }}px;
      --logo-h-mobile: {{ bulletin.appearance.logoMobile or 32 }}px;
      --badge-h: {{ bulletin.appearance.badgeDesktop or 100 }}px;
      --badge-h-mobile: {{ bulletin.appearance.badgeMobile or 80 }}px;
    }
    /* This block loads after styles.css, so the mobile swap must happen here too
       or the values above always win the cascade. */
    @media (max-width: 768px) {
      :root {
        --logo-h: var(--logo-h-mobile);
        --badge-h: var(--badge-h-mobile);
      }
    }
  </style>
  <script src="/assets/js/lucide.min.js" defer></script>
  <script src="/assets/js/bulletin.js" defer></script>
  <script>document.addEventListener('DOMContentLoaded', () => lucide.createIcons());</script>
</head>
<body{% if bulletin.contact.website and bulletin.backToWebsiteEnabled !== false %} class="has-back-link"{% endif %}>
  <a href="#main-content" class="skip-link">Skip to bulletin</a>

  <header class="site-header" role="banner">
    <div class="site-header__inner">
      <a href="{{ bulletin.contact.website or "/" }}" class="site-header__logo" aria-label="Calvary Chapel Antelope Valley — main website">
        <img src="/assets/ccav-wordmark-white.png" alt="Calvary Chapel Antelope Valley" />
      </a>
      <nav class="site-header__nav" aria-label="Site navigation">
        <a href="/">This Week</a>
        <a href="/previous/">Past Bulletins</a>
        {% if bulletin.giving and bulletin.giving.url %}
        <a href="{{ bulletin.giving.url }}" target="_blank" rel="noopener" class="btn btn--ochre">Give</a>
        {% endif %}
      </nav>
    </div>
  </header>

  <main id="main-content" tabindex="-1">
    {% block content %}{{ content | safe }}{% endblock %}
  </main>

  <footer class="site-footer" role="contentinfo">
    <div class="site-footer__inner">
      <a href="/" aria-label="Calvary Chapel Antelope Valley — home">
        <img src="/assets/ccav-wordmark-white.png" alt="Calvary Chapel Antelope Valley" class="site-footer__logo" />
      </a>

      <div class="site-footer__address">
        {{ bulletin.service.address }}
      </div>

      <nav class="site-footer__contact" aria-label="Contact information">
        {% if bulletin.contact.phone %}
        <a href="tel:{{ bulletin.contact.phone }}">{{ bulletin.contact.phone }}</a>
        {% endif %}
        {% if bulletin.contact.email %}
        <a href="mailto:{{ bulletin.contact.email }}">{{ bulletin.contact.email }}</a>
        {% endif %}
        {% if bulletin.contact.website %}
        <a href="{{ bulletin.contact.website }}" target="_blank" rel="noopener">calvarychapelav.org</a>
        {% endif %}
      </nav>

      <div class="site-footer__actions">
        {% if bulletin.giving and bulletin.giving.url %}
        <a href="{{ bulletin.giving.url }}" target="_blank" rel="noopener" class="btn btn--ochre">{{ bulletin.giving.text or "Give Online" }}</a>
        {% endif %}
        {% if bulletin.contact.website and bulletin.backToWebsiteEnabled !== false %}
        <a href="{{ bulletin.contact.website }}" class="btn btn--inv-outline">Visit Our Website <span aria-hidden="true">↗</span></a>
        {% endif %}
      </div>

      <p class="site-footer__copy">
        Calvary Chapel Antelope Valley &mdash; Acts 2:42
      </p>
    </div>
  </footer>

  {% if bulletin.contact.website and bulletin.backToWebsiteEnabled !== false %}
  <a href="{{ bulletin.contact.website }}" class="btn btn--ochre back-to-website">
    <i data-lucide="arrow-left" aria-hidden="true"></i> Back to Website
  </a>
  {% endif %}

</body>
</html>
